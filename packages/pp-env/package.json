{
	"name": "@pp/pp-env",
	"version": "0.0.0",
	"private": true,
	"license": "Apache-2.0",
	"description": "Privacy Pools v2 on a local anvil: fetch, deploy, mock ASP, and typed spend helpers.",
	"type": "module",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./src/index.ts"
		},
		"./client": {
			"types": "./types/client.d.ts",
			"default": "./src/client/index.ts"
		}
	},
	"imports": {
		"#ppv2/evm-sdk": "./.ppv2/packages/evm-sdk/dist/index.js",
		"#ppv2/mock-asp/evm": "./.ppv2/packages/mock-asp/dist/evm.js"
	},
	"bin": {
		"pp-env": "./src/cli.ts"
	},
	"scripts": {
		"fetch": "bun scripts/fetch.ts",
		"typecheck": "tsc -p tsconfig.public.json && bun scripts/typecheck-consumer.ts",
		"typecheck:full": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "bun test src scripts test/types",
		"check": "bun run typecheck && bun run typecheck:full && bun run lint && bun run test",
		"forge:fixtures": "bun scripts/forge-fixtures.ts",
		"test:contracts": "bun scripts/forge-fixtures.ts test",
		"test:smoke": "bun test test/smoke",
		"test:vitest": "bun --bun vitest run",
		"test:integration": "PP_ENV_INTEGRATION=1 bun test --timeout 600000 test/integration",
		"up": "bun src/cli.ts up"
	},
	"dependencies": {
		"@pp/pool-client": "workspace:*",
		"@pp/run-isolation": "workspace:*",
		"viem": "2.45.3"
	},
	"devDependencies": {
		"@openzeppelin/contracts": "5.4.0",
		"@types/bun": "1.4.4",
		"forge-std": "github:foundry-rs/forge-std#v1.14.0",
		"typescript": "6.0.3",
		"vitest": "^4.1.9"
	}
}
