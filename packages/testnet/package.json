		"@pp/pool-client": "workspace:*",
		"@pp/pp-env": "workspace:*",
		"@pp/run-isolation": "workspace:*",
		"@pp/sepolia-fork": "workspace:*",
		"viem": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
