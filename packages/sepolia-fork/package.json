{
	"name": "@pp/sepolia-fork",
	"version": "0.0.0",
	"private": true,
	"license": "Apache-2.0",
	"description": "The bridge's Ethereum side against the real Sepolia pool and Aztec testnet Inbox, on an owned anvil fork.",
	"type": "module",
	"exports": {
		"./anvil": "./src/anvil.ts",
		"./pins": "./src/pins.ts",
		"./rpc": "./src/rpc.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "bun test ./src/",
		"test:net": "bun test --timeout 600000 ./test/",
		"run": "bun src/cli.ts run",
		"pins": "bun src/cli.ts pins"
	},
	"dependencies": {
		"@pp/bridge-spec": "workspace:*",
		"@pp/pool-client": "workspace:*",
		"@pp/pp-env": "workspace:*",
		"@pp/run-isolation": "workspace:*",
		"viem": "catalog:pool"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	}
}
