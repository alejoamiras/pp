{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["bun"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "*.config.ts"]
}
