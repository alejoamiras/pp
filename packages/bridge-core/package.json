{
	"name": "@pp/bridge-core",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./artifacts": "./src/artifacts.ts",
		"./asp-registry-artifact": "./src/asp-registry-artifact.ts",
		"./sandbox": "./scripts/sandbox/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.scripts.json",
		"test": "bun --bun vitest run",
		"test:watch": "vitest",
		"deploy:sandbox": "bun scripts/deploy-sandbox.ts",
		"sandbox:up": "bun scripts/sandbox/cli.ts up",
		"sandbox:smoke": "bun scripts/sandbox/cli.ts run --smoke",
		"test:integration": "BRIDGE_INTEGRATION=1 bun --bun vitest run --config vitest.integration.config.ts",
		"test:registry": "BRIDGE_INTEGRATION=1 bun --bun vitest run --config vitest.registry.config.ts"
	},
	"dependencies": {
		"@pp/bridge-spec": "workspace:*",
		"@nulo-sh/resolve-asset": "catalog:",
		"@nulo-sh/wallet-crypto": "catalog:",
		"zod": "catalog:",
		"@pp/run-isolation": "workspace:*",
		"@aztec-labs/aztec.js": "6.0.0",
		"@aztec-labs/accounts": "6.0.0",
		"@aztec-labs/constants": "6.0.0",
		"@aztec-labs/ethereum": "6.0.0",
		"@aztec-labs/foundation": "6.0.0",
		"@aztec-foundation/l1-artifacts": "6.0.0",
		"@aztec-labs/noir-contracts.js": "6.0.0",
		"@aztec-labs/protocol-contracts": "6.0.0",
		"@aztec-labs/stdlib": "6.0.0",
		"@aztec-labs/wallets": "6.0.0",
		"@aztec-foundation/aztec-standards": "6.0.0",
		"viem": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
