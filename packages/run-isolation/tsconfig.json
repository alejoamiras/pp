{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ESNext"],
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": ["bun", "node"],
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true
	},
	"include": ["src/**/*.ts"]
}
