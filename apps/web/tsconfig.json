{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["node", "vite/client"],
		"paths": { "#data": ["./src/data/fixtures/index.ts"] }
	},
	"include": ["src", "scripts", "e2e", "vite.config.ts", "vitest.config.ts"]
}
