{
	"name": "pp",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"catalog": {
		"@biomejs/biome": "2.5.13",
		"@nulo-sh/resolve-asset": "0.3.0",
		"@nulo-sh/wallet-crypto": "0.3.0",
		"@playwright/test": "1.63.0",
		"@types/bun": "1.4.4",
		"@types/node": "^24.13.2",
		"fast-check": "^4.10.3",
		"typescript": "6.0.3",
		"viem": "2.57.1",
		"vite": "^8.3.8",
		"vite-plugin-node-polyfills": "^0.28.0",
		"vitest": "^4.1.12",
		"zod": "4.6.7"
	},
	"catalogs": {
		"pool": {
			"viem": "2.45.3"
		}
	},
	"scripts": {
		"lint": "biome check && bun scripts/complexity-baseline/check.ts",
		"lint:fix": "biome check --fix",
		"lint:actions": "actionlint",
		"format": "biome format --write",
		"check": "biome check",
		"typecheck:all": "bun run --filter '@pp/*' typecheck",
		"test:all": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun run --filter '@pp/*' --if-present test",
		"test:ci-gating": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun test scripts/ci-cd/",
		"test:unfetched": "bun scripts/unfetched.ts",
		"demo": "bun packages/local-stack/src/cli.ts demo",
		"nightly": "bun scripts/nightly.ts",
		"baseline:complexity": "bun scripts/complexity-baseline/generate.ts",
		"baseline:rescore": "bun scripts/complexity-baseline/rescore.ts",
		"check:imports": "biome check packages/",
		"prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@pp/run-isolation": "workspace:*"
	},
	"packageManager": "bun@1.4.2",
	"license": "Apache-2.0",
	"overrides": {
		"@0xbow/privacy-pools-v2-sdk": {
			"viem": "2.57.1"
		},
		"vite": "^8.3.8",
		"ws": "8.21.0",
		"@aztec-labs/aztec.js": {
			"zod": "4.6.7"
		},
		"@aztec-labs/entrypoints": {
			"zod": "4.6.7"
		},
		"@aztec-labs/ethereum": {
			"zod": "4.6.7"
		},
		"@aztec-labs/foundation": {
			"zod": "4.6.7"
		},
		"@aztec-labs/stdlib": {
			"zod": "4.6.7"
		},
		"@aztec-labs/world-state": {
			"zod": "4.6.7"
		}
	},
	"patchedDependencies": {
		"@aztec-foundation/noir-acvm_js@6.0.0": "patches/@aztec-foundation%2Fnoir-acvm_js@6.0.0.patch",
		"@aztec-foundation/noir-noirc_abi@6.0.0": "patches/@aztec-foundation%2Fnoir-noirc_abi@6.0.0.patch"
	}
}
