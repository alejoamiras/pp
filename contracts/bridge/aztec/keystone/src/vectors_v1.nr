    ];
    for i in 0..12 {
        let (token, owner, amount, secret, label, nullifier, siloed, id) = cases[i];
        let (token, owner) = (AztecAddress::from_field(token), AztecAddress::from_field(owner));
        assert(birth_label(token, owner, amount, secret) == label, f"birth[{i}]");
        assert(birth_nullifier(owner, secret) == nullifier, f"birth[{i}]");
        assert(compute_siloed_nullifier(token, nullifier) == siloed, f"birth[{i}]");
        assert(birth_id(label, secret) == id, f"birth[{i}]");
    }
}

#[test(should_fail_with = "AmountOutOfRange")]
unconstrained fn v1_rejection_04_in_amount_zero() {
    let _ = bridge_content_v1(0x1, 0x1, 0x0);
}

#[test(should_fail_with = "ZeroPayee")]
unconstrained fn v1_rejection_06_out_payee_zero() {
    let _ = exit_content_v1(EthAddress::deserialize([0x0]), 0x1);
}

#[test(should_fail_with = "PayeeOutOfRange")]
unconstrained fn v1_rejection_07_out_payee_2_160() {
    let _ = exit_content_v1(EthAddress::deserialize([0x10000000000000000000000000000000000000000]), 0x1);
}

#[test(should_fail_with = "AmountOutOfRange")]
unconstrained fn v1_rejection_08_out_amount_zero() {
    let _ = exit_content_v1(EthAddress::deserialize([0x44a4]), 0x0);
}

#[test(should_fail_with = "ZeroPayee")]
unconstrained fn v1_rejection_10_rq_payee_zero() {
    let _ = ragequit_content_v1(EthAddress::deserialize([0x0]), 0x1, 0x1);
}

#[test(should_fail_with = "PayeeOutOfRange")]
unconstrained fn v1_rejection_11_rq_payee_2_160() {
    let _ = ragequit_content_v1(EthAddress::deserialize([0x10000000000000000000000000000000000000000]), 0x1, 0x1);
}

#[test(should_fail_with = "AmountOutOfRange")]
unconstrained fn v1_rejection_12_rq_amount_zero() {
    let _ = ragequit_content_v1(EthAddress::deserialize([0x44a4]), 0x0, 0x1);
}

#[test(should_fail_with = "LabelOutOfRange")]
unconstrained fn v1_rejection_14_rq_label_zero() {
    let _ = ragequit_content_v1(EthAddress::deserialize([0x44a4]), 0x1, 0x0);
}

#[test(should_fail_with = "DepthOutOfRange")]
unconstrained fn v1_rejection_16_path_depth_19() {
    let _ = lean_imt_root(0x1234, LabelPath { index: 0, depth: 19, siblings: [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0] });
}

#[test(should_fail_with = "IndexOutOfRange")]
unconstrained fn v1_rejection_17_path_index_bit_at_depth() {
    let _ = lean_imt_root(0x1234, LabelPath { index: 4, depth: 2, siblings: [0x5, 0x6, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0] });
}

#[test(should_fail_with = "SiblingOutOfRange")]
unconstrained fn v1_rejection_18_path_sibling_past_depth() {
    let _ = lean_imt_root(0x1234, LabelPath { index: 0, depth: 1, siblings: [0x5, 0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0] });
}

#[test(should_fail_with = "ZeroRoot")]
unconstrained fn v1_rejection_20_member_root_zero() {
    let _ = assert_lean_imt_member(0x1234, LabelPath { index: 0, depth: 0, siblings: [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0] }, 0x0);
}

#[test(should_fail_with = "NotMember")]
unconstrained fn v1_rejection_21_member_wrong_root() {
    let _ = assert_lean_imt_member(0x1234, LabelPath { index: 0, depth: 0, siblings: [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0] }, 0x1235);
