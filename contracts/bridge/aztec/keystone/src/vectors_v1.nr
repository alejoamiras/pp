        assert_lean_imt_member(leaf, path, root);
    }
}

#[test]
unconstrained fn v1_claim_secret_hash() {
    let cases: [(Field, Field, Field, Field); 8] = [
        (0x0, 0x0, 0x1f17a9afc746bb16b48b40e27204959589a14c8da06e6562f1f730e71ba56571, 0x21dda6113edeb23b9b0267ed92219f361a88095de9c7f47d80c208b3858f42fd),
        (0x1, 0x2, 0xe1c1bc4c90f0e15e3c4d18ad4ab43c07f8ff9c230d24a5295b41a32ae9fd397, 0x1ce9b36531e066f21da630794455329ccf900519a6873e7c9b710b245979ecdc),
        (0x1234567890abcdef, 0xdeadbeef, 0x1bf3b96e42ed3d8ce072727e05ea920b23adf8a9effde855584a6a26d9f4eb37, 0x16b3c095d59a7813e217f2d377b94def432072bf495fae1ef2c15d6ac714b61c),
        (0x266962906d56b48dcdeb045b01962d1d64c67a39035911a82efaba8727d49302, 0x8c508573ea87ffaa3d277d0e21fe53e58c0a4cda0122a7977588e385dfc3c47, 0xa441cd2226aa5fbb60aacdd72cba2243b226763d55ef765f1b47e0df5bf6130, 0x12b983f7b33268dfc4f371e8dba8170d0b93f1940e6ba608f909bdc59a9424b8),
        (0x1ed7a64eec23b0a97ddede0dfe3ef18a16c4b86f1e05bfbef6fc5a891b5bcb74, 0xca38b7a8e6d15bc0ac26affe6b5bc0feeac15cd3d1da330f675dcb9f0da9047, 0x13b565ce5d7bec60416005f10da2283b9e01e556f6dda2267934eea9e9f24070, 0x286a1ee00de81078b91ee76968dad6b153a49bda44e68460aa6cbb5d6a580dc),
        (0x1a26b755d23edc95efb585d14b94bbf4402f540600784236f93141ced9cbb439, 0x2e7ba99646dc5b35cf1420d9374c8a21d4e748eab5b8b152d2d9047177587b7e, 0x109d8cab56fd778bfb3cb65068f12250d13482b5db7f6b95e83e365a60997311, 0x1dbf908ae771318a12de2ccae4b72504deaa1fbaae9f5e2388adccb129aaa878),
        (0xc7e978d0caf29f9433a4c15be70222d440b790017b30351a9c9b0e7d06c1246, 0x79f426bb3c8d2f16a51618e1d8e97728c8cf2db7c5de2fcb77eff5bb9c95fb6, 0x294dd6d005c3b6e942cd37ee72f18627a9b898f3d45b1966a0adc3263646a625, 0x2599144a5e7ba239ba165ec8e04cf507dbb5b1f6b5b1e6e7c2b788eefcdab318),
        (0x9ef39284f32dc90c9e2034cea60b7f080990cb970a8cb56155f482155b0efd4, 0x2db3189b5311c0c729affd7bc624d525f271b8cd7180d8ee397549bd9098e0a8, 0x12355c2abd2b16ffc16a7fd9331af0980fff6a4d04a2e852b41f96f072daa7dd, 0x29ccb0056719c50f3f7b2754c6db8c5f838bc37774321c9c61db9b9ca718045c),
    ];
    for i in 0..8 {
        let (salt, recipient, secret, secret_hash) = cases[i];
        assert(derive_claim_secret(salt, AztecAddress::from_field(recipient)) == secret, f"claimSecretHash[{i}]");
        assert(compute_secret_hash([secret]) == secret_hash, f"claimSecretHash[{i}]");
    }
}

