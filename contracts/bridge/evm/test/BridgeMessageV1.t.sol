pragma solidity >=0.8.27;

import {Test} from "forge-std/Test.sol";
import {BridgeMessageV1} from "../src/libraries/BridgeMessageV1.sol";

/// External entry points, so a revert is observable through try/catch.
contract BridgeMessageV1Harness {
    function bridgeData(bytes32 secretHash) external pure returns (bytes memory) {
        return BridgeMessageV1.bridgeData(secretHash);
    }

    function bridgeContentPreimage(uint256 n, uint256 c, uint256 a) external pure returns (bytes memory) {
        return BridgeMessageV1.bridgeContentPreimage(n, c, a);
    }

    function bridgeContent(uint256 n, uint256 c, uint256 a) external pure returns (bytes32) {
        return BridgeMessageV1.bridgeContent(n, c, a);
    }

    function exitContentPreimage(address payee, uint256 a) external pure returns (bytes memory) {
        return BridgeMessageV1.exitContentPreimage(payee, a);
    }

    function exitContent(address payee, uint256 a) external pure returns (bytes32) {
        return BridgeMessageV1.exitContent(payee, a);
    }

    function ragequitContentPreimage(address payee, uint256 a, uint256 label) external pure returns (bytes memory) {
        return BridgeMessageV1.ragequitContentPreimage(payee, a, label);
    }

    function ragequitContent(address payee, uint256 a, uint256 label) external pure returns (bytes32) {
        return BridgeMessageV1.ragequitContent(payee, a, label);
    }
}

/// @notice Checks the library against `packages/bridge-spec/vectors/v1.json`, generated by the TS
/// reference. The sections, their exact sizes and the rejection names are written here by hand, so
/// a generator that drops a vector together with its count still fails. `BRIDGE_SPEC_VECTORS`
/// points the suite at another copy inside the read grant (the mutation run uses it).
contract BridgeMessageV1Test is Test {
    uint256 internal constant TAGS = 4;
    uint256 internal constant DATA = 66;
    uint256 internal constant IN = 73;
    uint256 internal constant OUT = 69;
    uint256 internal constant RAGEQUIT = 71;
    uint256 internal constant REJECTIONS = 23;
    uint256 internal constant SOL_REJECTIONS = 14;

    BridgeMessageV1Harness internal h;
    string internal json;

    function setUp() public {
        h = new BridgeMessageV1Harness();
        json = vm.readFile(vm.envOr("BRIDGE_SPEC_VECTORS", string("../../../packages/bridge-spec/vectors/v1.json")));
    }

    function _key(string memory section, uint256 i, string memory field) internal pure returns (string memory) {
        return string.concat(".", section, "[", vm.toString(i), "].", field);
    }

    function _at(string memory section, uint256 i) internal pure returns (string memory) {
        return string.concat(section, "[", vm.toString(i), "]");
    }

    function _uint(string memory section, uint256 i, string memory field) internal view returns (uint256) {
        return vm.parseJsonUint(json, _key(section, i, field));
    }

    function test_counts() public view {
        string[6] memory sections = ["tags", "data", "in", "out", "ragequit", "rejections"];
        uint256[6] memory sizes = [TAGS, DATA, IN, OUT, RAGEQUIT, REJECTIONS];
        for (uint256 s = 0; s < sections.length; s++) {
            string memory section = sections[s];
            assertEq(vm.parseJsonUint(json, string.concat(".counts.", section)), sizes[s], section);
            assertTrue(vm.keyExistsJson(json, string.concat(".", section, "[", vm.toString(sizes[s] - 1), "]")), section);
            assertFalse(vm.keyExistsJson(json, string.concat(".", section, "[", vm.toString(sizes[s]), "]")), section);
        }
    }

    function test_tags() public view {
        bytes32[4] memory tags = [
            BridgeMessageV1.PP_BRIDGE_DATA_V1,
            BridgeMessageV1.PP_BRIDGE_IN_V1,
            BridgeMessageV1.PP_BRIDGE_OUT_V1,
            BridgeMessageV1.PP_BRIDGE_RAGEQUIT_V1
        ];
        for (uint256 i = 0; i < TAGS; i++) {
            assertEq(tags[i], vm.parseJsonBytes32(json, _key("tags", i, "value")), _at("tags", i));
        }
    }

    function test_data() public view {
        for (uint256 i = 0; i < DATA; i++) {
            bytes32 secretHash = vm.parseJsonBytes32(json, _key("data", i, "secretHash"));
            assertEq(h.bridgeData(secretHash), vm.parseJsonBytes(json, _key("data", i, "data")), _at("data", i));
        }
    }

    function test_in() public view {
        for (uint256 i = 0; i < IN; i++) {
            (uint256 n, uint256 c, uint256 a) = (_uint("in", i, "nullifier"), _uint("in", i, "changeCommitment"), _uint("in", i, "amount"));
            assertEq(h.bridgeContentPreimage(n, c, a), vm.parseJsonBytes(json, _key("in", i, "preimage")), _at("in", i));
            assertEq(h.bridgeContent(n, c, a), vm.parseJsonBytes32(json, _key("in", i, "content")), _at("in", i));
        }
    }

    function test_out() public view {
        for (uint256 i = 0; i < OUT; i++) {
            (address payee, uint256 a) = (vm.parseJsonAddress(json, _key("out", i, "payee")), _uint("out", i, "amount"));
            assertEq(h.exitContentPreimage(payee, a), vm.parseJsonBytes(json, _key("out", i, "preimage")), _at("out", i));
            assertEq(h.exitContent(payee, a), vm.parseJsonBytes32(json, _key("out", i, "content")), _at("out", i));
        }
    }

    function test_ragequit() public view {
        for (uint256 i = 0; i < RAGEQUIT; i++) {
            address payee = vm.parseJsonAddress(json, _key("ragequit", i, "payee"));
            (uint256 a, uint256 label) = (_uint("ragequit", i, "amount"), _uint("ragequit", i, "label"));
            bytes memory pre = vm.parseJsonBytes(json, _key("ragequit", i, "preimage"));
            assertEq(h.ragequitContentPreimage(payee, a, label), pre, _at("ragequit", i));
            assertEq(h.ragequitContent(payee, a, label), vm.parseJsonBytes32(json, _key("ragequit", i, "content")), _at("ragequit", i));
        }
    }

    function test_rejections() public view {
        uint256 checked;
        bool[5] memory seen;
        for (uint256 i = 0; i < REJECTIONS; i++) {
            if (!_forSolidity(i)) continue;
            string memory err = vm.parseJsonString(json, _key("rejections", i, "error"));
            (bytes memory want, uint256 kind) = _expected(i, err);
            seen[kind] = true;
            assertEq(_revertData(i), want, string.concat(_at("rejections", i), " ", err));
            checked++;
        }
        assertEq(checked, SOL_REJECTIONS, "solidity rejections");
        for (uint256 k = 0; k < seen.length; k++) {
            assertTrue(seen[k], "every Solidity rejection name has a vector");
        }
    }

    function _forSolidity(uint256 i) internal view returns (bool) {
        string[] memory langs = vm.parseJsonStringArray(json, _key("rejections", i, "langs"));
        for (uint256 l = 0; l < langs.length; l++) {
            if (keccak256(bytes(langs[l])) == keccak256("sol")) return true;
        }
        return false;
    }

    function _arg(uint256 i, string memory name) internal view returns (uint256) {
        return vm.parseJsonUint(json, string.concat(".rejections[", vm.toString(i), "].args.", name));
    }

    /// The exact revert data the vector demands, and which of the five names it is.
    function _expected(uint256 i, string memory err) internal view returns (bytes memory, uint256) {
        bytes32 e = keccak256(bytes(err));
        if (e == keccak256("SecretHashOutOfRange")) {
            return (abi.encodeWithSelector(BridgeMessageV1.SecretHashOutOfRange.selector, bytes32(_arg(i, "secretHash"))), 0);
        }
        if (e == keccak256("FieldOutOfRange")) {
            uint256 n = _arg(i, "nullifier");
            uint256 bad = n >= BridgeMessageV1.P ? n : _arg(i, "changeCommitment");
            return (abi.encodeWithSelector(BridgeMessageV1.FieldOutOfRange.selector, bad), 1);
        }
        if (e == keccak256("AmountOutOfRange")) {
            return (abi.encodeWithSelector(BridgeMessageV1.AmountOutOfRange.selector, _arg(i, "amount")), 2);
        }
        if (e == keccak256("ZeroPayee")) return (abi.encodeWithSelector(BridgeMessageV1.ZeroPayee.selector), 3);
        if (e == keccak256("LabelOutOfRange")) {
            return (abi.encodeWithSelector(BridgeMessageV1.LabelOutOfRange.selector, _arg(i, "label")), 4);
        }
        revert(string.concat(_at("rejections", i), ": not a Solidity rejection name: ", err));
    }

    /// Calls the vector's function; a call that returns is reported as empty revert data.
    function _revertData(uint256 i) internal view returns (bytes memory) {
        bytes32 fn = keccak256(bytes(vm.parseJsonString(json, _key("rejections", i, "fn"))));
        if (fn == keccak256("bridgeData")) {
            try h.bridgeData(bytes32(_arg(i, "secretHash"))) {} catch (bytes memory r) { return r; }
        } else if (fn == keccak256("bridgeContent")) {
            try h.bridgeContent(_arg(i, "nullifier"), _arg(i, "changeCommitment"), _arg(i, "amount")) {} catch (bytes memory r) { return r; }
        } else if (fn == keccak256("exitContent")) {
            try h.exitContent(address(uint160(_arg(i, "payee"))), _arg(i, "amount")) {} catch (bytes memory r) { return r; }
        } else if (fn == keccak256("ragequitContent")) {
            address payee = address(uint160(_arg(i, "payee")));
            try h.ragequitContent(payee, _arg(i, "amount"), _arg(i, "label")) {} catch (bytes memory r) { return r; }
        } else {
            revert(string.concat(_at("rejections", i), ": no Solidity function"));
        }
        return "";
    }

    function testFuzz_dataDecodesToItsTagAndSecretHash(uint256 raw) public view {
        bytes32 secretHash = bytes32(bound(raw, 1, BridgeMessageV1.P - 1));
        (bytes32 tag, bytes32 decoded) = abi.decode(h.bridgeData(secretHash), (bytes32, bytes32));
        assertEq(tag, BridgeMessageV1.PP_BRIDGE_DATA_V1);
        assertEq(decoded, secretHash);
    }

    function testFuzz_amountInRangeEncodes(uint256 raw) public view {
        uint256 amount = bound(raw, 1, type(uint128).max);
        (,,, uint256 decoded) = abi.decode(h.bridgeContentPreimage(1, 2, amount), (bytes32, uint256, uint256, uint256));
        assertEq(decoded, amount);
        (,, uint256 exitAmount) = abi.decode(h.exitContentPreimage(address(1), amount), (bytes32, address, uint256));
        assertEq(exitAmount, amount);
    }

    function testFuzz_amountAboveRangeReverts(uint256 raw) public {
        uint256 amount = bound(raw, uint256(type(uint128).max) + 1, type(uint256).max);
        bytes memory want = abi.encodeWithSelector(BridgeMessageV1.AmountOutOfRange.selector, amount);
        vm.expectRevert(want);
        h.bridgeContent(1, 2, amount);
        vm.expectRevert(want);
        h.exitContent(address(1), amount);
        vm.expectRevert(want);
        h.ragequitContent(address(1), amount, 1);
    }
}
